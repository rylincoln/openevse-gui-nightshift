{
  "name": "openevse-gui-nightshift",
  "private": true,
  "version": "2026.37.1",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-http-header-size=65536 vite",
    "dev:mock": "cross-env NODE_OPTIONS=--max-http-header-size=65536 vite --mode mock",
    "build": "vite build",
    "preview": "cross-env NODE_OPTIONS=--max-http-header-size=65536 vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "node scripts/build-locale-values.mjs && svelte-check --tsconfig ./tsconfig.json",
    "icons": "node scripts/gen-icons.mjs",
    "screenshots": "cross-env NODE_OPTIONS=--max-http-header-size=65536 node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@gfx/zopfli": "^1.0.15",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/luxon": "^3.7.5",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "iconify-icon": "^3.0.2",
    "luxon": "^3.7.2",
    "promise-batching-queue": "^0.0.5",
    "svelte-i18n": "^4.0.1",
    "svelte-local-storage-store": "^0.6.4",
    "uplot": "^1.6.32"
  }
}
